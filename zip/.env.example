GEMINI_API_KEY=your_key_here
GEMINI_MODEL=gemini-2.5-flash

# Частина URL дашборду, за якою програма знаходить вкладку
DASHBOARD_URL_PART=zgraf.ab.loc
# Повний URL, який відкриється, якщо програма сама запускає Chrome
DASHBOARD_URL=

# true — додавати до аналізу скріншоти, false (за замовчуванням) — тільки текст
USE_SCREENSHOTS=false

# Необов'язково, якщо значення за замовчуванням не підходять
# CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
# CHROME_PROFILE_DIR=C:\chrome-debug-profile
# CDP_URL=http://localhost:9222
# MAX_SCREENSHOTS=6
